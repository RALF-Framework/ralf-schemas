{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ralf-framework.org/draft/2020-12/ralf-lifecycle.schema.json",
  "title": "RALF Lifecycle",
  "description": "A structured model of how work moves through phases, states, gates, and feedback loops.",
  "type": "object",
  "required": [
    "id",
    "name",
    "phases"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "name": {
      "$ref": "common.schema.json#/$defs/non_empty_string"
    },
    "description": {
      "type": "string"
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/phase"
      }
    },
    "transitions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/transition"
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/gate"
      }
    },
    "feedback_loops": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/feedback_loop"
      }
    },
    "metadata": {
      "$ref": "common.schema.json#/$defs/metadata"
    },
    "extensions": {
      "$ref": "common.schema.json#/$defs/extension_object"
    }
  },
  "$defs": {
    "phase": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "name": {
          "$ref": "common.schema.json#/$defs/non_empty_string"
        },
        "description": {
          "type": "string"
        },
        "responsible_roles": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/identifier"
          },
          "uniqueItems": true
        },
        "expected_inputs": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/identifier"
          },
          "uniqueItems": true
        },
        "expected_outputs": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/identifier"
          },
          "uniqueItems": true
        },
        "entry_criteria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exit_criteria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "extensions": {
          "$ref": "common.schema.json#/$defs/extension_object"
        }
      }
    },
    "transition": {
      "type": "object",
      "required": [
        "from",
        "to"
      ],
      "additionalProperties": false,
      "properties": {
        "from": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "to": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "trigger": {
          "type": "string"
        },
        "gate": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "extensions": {
          "$ref": "common.schema.json#/$defs/extension_object"
        }
      }
    },
    "gate": {
      "type": "object",
      "required": [
        "id",
        "name",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "name": {
          "$ref": "common.schema.json#/$defs/non_empty_string"
        },
        "type": {
          "type": "string",
          "enum": [
            "approval",
            "quality-check",
            "risk-review",
            "compliance-review",
            "technical-review",
            "release-decision",
            "human-override"
          ]
        },
        "decision_owner_role": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "required_artifacts": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/identifier"
          },
          "uniqueItems": true
        },
        "policy_refs": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/identifier"
          },
          "uniqueItems": true
        },
        "extensions": {
          "$ref": "common.schema.json#/$defs/extension_object"
        }
      }
    },
    "feedback_loop": {
      "type": "object",
      "required": [
        "from",
        "to",
        "reason"
      ],
      "additionalProperties": false,
      "properties": {
        "from": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "to": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "reason": {
          "type": "string"
        },
        "extensions": {
          "$ref": "common.schema.json#/$defs/extension_object"
        }
      }
    }
  }
}
